# ==============================================
# AI CONFIGURATION
# ==============================================

# Gemini API Key (required for AI evaluation)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Alternative AI Provider (optional)
# AI_PROVIDER=gemini
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4-turbo-preview

# ==============================================
# GITHUB CONFIGURATION
# ==============================================

# GitHub Personal Access Token (optional but recommended)
# Provides detailed commit analysis and higher API rate limits
# Get your token from: https://github.com/settings/tokens
# Required scopes: repo (read access to repositories)
GITHUB_TOKEN=your_github_token_here

# Directory for cloning repositories (default: cloned_repos)
CLONE_DIR=cloned_repos

# ==============================================
# GOOGLE SHEETS CONFIGURATION
# ==============================================

# Google Spreadsheet ID (required)
# Find this in your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet name (default: Sheet1)
SHEET_NAME=Sheet1

# ==============================================
# COLUMN CONFIGURATION
# ==============================================

# For GitHub Repository Evaluation
REPO_LINK_COLUMN=A
TEAM_NAME_COLUMN=B
SCORE_COLUMN=C
FEEDBACK_COLUMN=D
CONTRIBUTORS_COLUMN=E

# For Document Evaluation (legacy)
DOC_LINK_COLUMN=A
STUDENT_NAME_COLUMN=B

# ==============================================
# GOOGLE SERVICE ACCOUNT
# ==============================================

# Path to service account JSON file (default: credentials/service_account.json)
SERVICE_ACCOUNT_FILE=credentials/service_account.json

# ==============================================
# PROCESSING CONFIGURATION
# ==============================================

# Maximum number of concurrent workers (default: 5)
MAX_WORKERS=5

# Number of retry attempts for API calls (default: 3)
RETRY_ATTEMPTS=3

# Batch size for processing (default: 10)
BATCH_SIZE=10

# Include plagiarism check (default: True)
INCLUDE_PLAGIARISM_CHECK=True
